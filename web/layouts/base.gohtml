{{ define "base" }}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{ if .Title }}{{ .Title }} · {{ end }}Govoort</title>
    <link href="/static/output.css" rel="stylesheet">
</head>
<body>
<header>
    <div class="container">
        {{ template "header" . }}
    </div>
</header>
<main>
    {{ block "content" . }}{{ end }}
</main>
<footer>
    <div class="container">
        {{ template "footer" . }}
    </div>
</footer>
<script>
(function() {
  const endpoint = '/__version';
  let current = null;
  async function check() {
    try {
      const res = await fetch(endpoint, { cache: 'no-store' });
      if (!res.ok) return; // silently ignore
      const data = await res.json();
      const start = data && data.start;
      if (typeof start !== 'number') return;
      if (current === null) {
        current = start;
      } else if (start !== current) {
        location.reload();
      }
    } catch (_) {
      // ignore network errors (e.g., during rebuild); next tick will retry
    }
  }
  check();
  setInterval(check, 1000);
})();
</script>
</body>
</html>
{{ end }}
