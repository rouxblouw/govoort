{{ define "content" }}
    <h1 class="text-3xl font-bold text-blue-600">Hello</h1>
    <p class="text-gray-700">This page demonstrates a POST action on the same route. Submitting the form will invoke the "greet" action for POST /blog/hello.</p>
    <form method="post" class="space-y-4">
        <input type="hidden" name="action" value="greet">
        <label for="name" class="block text-sm font-medium text-gray-700">Your name:</label>
        <input id="name" name="name" placeholder="Ada" class="border border-gray-300 rounded-md px-3 py-2" />
        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600">Greet</button>
    </form>
    {{ if .Message }}
        <p class="mt-4"><strong class="text-green-600">Server says:</strong> {{ .Message }}</p>
    {{ end }}
{{ end }}